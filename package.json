{
  "name": "@local/dsh-plugin-aliyun-ecs-connect",
  "version": "0.2.0",
  "description": "Start an Alibaba Cloud ECS instance on demand, read its current public IP, and open an SSH terminal.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
