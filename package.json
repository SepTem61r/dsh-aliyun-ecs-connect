    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "aliyun",
    "alibaba-cloud",
    "ecs",
    "ssh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SepTem61r/dsh-aliyun-ecs-connect.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
